{
  "name": "skillos",
  "version": "0.2.0",
  "description": "Operating system for AI agent skills",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "skillos": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "cli": "node dist/cli/index.js",
    "test": "jest",
    "test:coverage": "jest --coverage --runInBand",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "agents",
    "skills",
    "agent-skills",
    "ai-agents",
    "claude-code",
    "codex",
    "registry",
    "cli"
  ],
  "author": "SkillOS Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anecodw/SkillOS.git"
  },
  "bugs": {
    "url": "https://github.com/anecodw/SkillOS/issues"
  },
  "homepage": "https://github.com/anecodw/SkillOS#readme",
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "axios": "^1.6.5",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "inquirer": "^9.2.12",
    "js-yaml": "^4.1.0",
    "lowdb": "^7.0.1",
    "marked": "^11.1.1",
    "ora": "^8.0.1",
    "semver": "^7.5.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.5",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
